generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(uuid())
  email     String      @unique
  password  String?
  name      String?
  avatarUrl String?
  avatarType String?    // 'vrm' or 'glb'
  createdAt DateTime    @default(now())
  images    UserImage[]
  orders    Order[]
  tryOns    TryOnEvent[]
}

model UserImage {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  url       String
  meta      String?  // JSON as String for SQLite
  createdAt DateTime @default(now())
}

model Product {
  id          String         @id @default(uuid())
  sku         String         @unique
  title       String
  description String?
  priceCents  Int
  published   Boolean        @default(false)
  assets      ProductAsset[]
  tryOns      TryOnEvent[]
  createdAt   DateTime       @default(now())
}

model ProductAsset {
  id        String    @id @default(uuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  type      String    // AssetType as String for SQLite
  url       String
  metadata  String?   // JSON as String for SQLite
  createdAt DateTime  @default(now())
}

// AssetType values: IMAGE_2D, MODEL_GLTF, PBR_BASECOLOR, PBR_NORMAL, PBR_METALROUGH, HDRI

model TryOnEvent {
  id        String     @id @default(uuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId String?
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  mode      String     // TryOnMode as String for SQLite
  metadata  String?    // JSON as String for SQLite
  createdAt DateTime   @default(now())
}

// TryOnMode values: PHOTO, MODEL3D

model Order {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalCents Int
  status     String
  createdAt  DateTime @default(now())
}
