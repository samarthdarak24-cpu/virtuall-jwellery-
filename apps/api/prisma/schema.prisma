generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(uuid())
  email     String      @unique
  password  String?
  name      String?
  createdAt DateTime    @default(now())
  images    UserImage[]
  orders    Order[]
  tryOns    TryOnEvent[]
}

model UserImage {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  url       String
  meta      Json?
  createdAt DateTime @default(now())
}

model Product {
  id          String         @id @default(uuid())
  sku         String         @unique
  title       String
  description String?
  priceCents  Int
  published   Boolean        @default(false)
  assets      ProductAsset[]
  tryOns      TryOnEvent[]
  createdAt   DateTime       @default(now())
}

model ProductAsset {
  id        String    @id @default(uuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  type      AssetType
  url       String
  metadata  Json?
  createdAt DateTime  @default(now())
}

enum AssetType {
  IMAGE_2D
  MODEL_GLTF
  PBR_BASECOLOR
  PBR_NORMAL
  PBR_METALROUGH
  HDRI
}

model TryOnEvent {
  id        String     @id @default(uuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId String?
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  mode      TryOnMode
  metadata  Json?
  createdAt DateTime   @default(now())
}

enum TryOnMode {
  PHOTO
  MODEL3D
}

model Order {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalCents Int
  status     String
  createdAt  DateTime @default(now())
}
